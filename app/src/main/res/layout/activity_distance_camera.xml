<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/distanceRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#202020" />

    <!-- Transparent controls leave the preview visible. -->
    <LinearLayout
        android:id="@+id/topDistanceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnDistanceBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:contentDescription="@string/distance_back"
            android:shadowColor="#99000000"
            android:shadowRadius="2"
            android:shadowDy="1"
            android:textColor="#FFFFFF"
            android:textSize="42sp" />

    </LinearLayout>

    <!--
        중앙 기준점입니다.

        십자선처럼 화면 전체를 가리지 않도록
        아주 작은 코너 마커 4개만 배치했습니다.
    -->
    <FrameLayout
        android:id="@+id/centerMarkerLayout"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center">

        <View
            android:id="@+id/markerTopLeftHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="top|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopLeftVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="top|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopRightHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="top|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopRightVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomLeftHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomLeftVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomRightHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomRightVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:background="#DDFFFFFF" />

    </FrameLayout>

    <!-- One compact readout just below the center marker. -->
    <FrameLayout
        android:id="@+id/distanceHudLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvCurrentDistanceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:translationY="80dp"
            android:background="@drawable/bg_distance_hud"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxWidth="280dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/distance_move_sideways"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/distance_hint_size" />

    </FrameLayout>

</FrameLayout>
