<?xml version="1.0" encoding="utf-8"?>
<!-- Only user settings migrate; ARCore acknowledgement and capture saves stay local. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="exposure_settings.xml" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="exposure_settings.xml" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </device-transfer>
</data-extraction-rules>
