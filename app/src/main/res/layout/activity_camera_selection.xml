<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cameraPickerRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:orientation="vertical">
    <View android:id="@+id/cameraPickerStatusSpace" android:layout_width="match_parent" android:layout_height="0dp"
        android:background="#151515" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/cameraPickerBack" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_roll_back" android:padding="12dp"
            android:contentDescription="@string/back" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/roll_choose_camera" android:textStyle="bold" android:textSize="20sp"
            android:textColor="#151515" android:tag="roll_heading" />
    </LinearLayout>
    <EditText android:id="@+id/cameraPickerSearch" style="@style/RollInput" android:layout_margin="12dp"
        android:hint="@string/roll_camera_search" android:inputType="text" android:maxLength="100"
        android:imeOptions="actionDone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <ScrollView android:layout_width="120dp" android:layout_height="match_parent" android:background="#F3F5F8">
            <LinearLayout android:id="@+id/cameraPickerBrands" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <ScrollView android:id="@+id/cameraPickerModelsScroll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <LinearLayout android:id="@+id/cameraPickerModels" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp" />
        </ScrollView>
    </LinearLayout>
    <View android:id="@+id/cameraPickerNavigationSpace" android:layout_width="match_parent" android:layout_height="0dp"
        android:background="#000000" android:importantForAccessibility="no" />
</LinearLayout>
