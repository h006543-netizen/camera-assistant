<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <!-- 상단 앱바: 고정 영역 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="22dp"
        android:background="#151515">

        <TextView
            android:id="@+id/tvCameraIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▣"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:text="필름카메라 보조"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- 본문 스크롤 영역 -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <!-- 노출 설정 카드 -->
            <LinearLayout
                android:id="@+id/cardExposure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="26dp"
                android:paddingEnd="26dp"
                android:paddingBottom="22dp">

                <!-- 제목 영역 -->
                <LinearLayout
                    android:id="@+id/exposureTitleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExposureIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="☼"
                        android:textColor="#111111"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvExposureTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:text="노출 설정"
                        android:textColor="#111111"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvExposureDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="필름 촬영을 위한 기본 노출 값을 설정하세요."
                    android:textColor="#777777"
                    android:textSize="15sp" />

                <!-- ISO / 조리개 / 셔터속도 -->
                <LinearLayout
                    android:id="@+id/exposureValueLayout"
                    android:layout_width="match_parent"
                    android:layout_height="142dp"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <!-- ISO -->
                    <LinearLayout
                        android:id="@+id/boxIso"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_value_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvIsoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="ISO"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvIsoValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="200"
                            android:textColor="#1E4F9A"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="32sp"
                            app:autoSizeMinTextSize="22sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/tvIsoArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:includeFontPadding="false"
                            android:text="∨"
                            android:textColor="#111111"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 조리개 -->
                    <LinearLayout
                        android:id="@+id/boxAperture"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_value_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvApertureLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="조리개"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvApertureValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="f/2.8"
                            android:textColor="#1E4F9A"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="32sp"
                            app:autoSizeMinTextSize="22sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/tvApertureArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:includeFontPadding="false"
                            android:text="∨"
                            android:textColor="#111111"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 셔터속도 -->
                    <LinearLayout
                        android:id="@+id/boxShutter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_value_box"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvShutterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="셔터속도"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvShutterValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="1/125"
                            android:textColor="#1E4F9A"
                            android:textSize="31sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="31sp"
                            app:autoSizeMinTextSize="20sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/tvShutterArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:includeFontPadding="false"
                            android:text="∨"
                            android:textColor="#111111"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 안내 문구 -->
                <LinearLayout
                    android:id="@+id/infoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvInfoIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="ⓘ"
                        android:textColor="#8A8A8A"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvInfoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="값을 탭하여 변경할 수 있습니다."
                        android:textColor="#8A8A8A"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- 노출계 버튼 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExposureCamera"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_btn_dark"
                    android:maxLines="1"
                    android:stateListAnimator="@null"
                    android:text="▣   노출계 카메라 실행"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- 카드 간격 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="18dp" />

            <!-- 거리 측정 카드 -->
            <LinearLayout
                android:id="@+id/cardDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="28dp"
                android:paddingEnd="26dp"
                android:paddingBottom="22dp">

                <!-- 거리 측정 제목 영역 -->
                <LinearLayout
                    android:id="@+id/distanceTitleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDistanceIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="▣"
                        android:textColor="#111111"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tvDistanceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:text="거리 측정"
                        android:textColor="#111111"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDistanceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="거리계를 사용하여 피사체까지의 거리를 측정하세요."
                    android:textColor="#777777"
                    android:textSize="15sp" />

                <!-- 거리계 버튼 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDistanceCamera"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_btn_blue"
                    android:maxLines="1"
                    android:stateListAnimator="@null"
                    android:text="▣   거리계 카메라 실행"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
