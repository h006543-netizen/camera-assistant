<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/distanceRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/cameraPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#202020" />

    <!-- 상단 반투명 앱바 -->
    <LinearLayout
        android:id="@+id/topDistanceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnDistanceBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/tvDistanceCameraTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:includeFontPadding="false"
            android:text="거리계"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
        중앙 기준점입니다.

        십자선처럼 화면 전체를 가리지 않도록
        아주 작은 코너 마커 4개만 배치했습니다.
    -->
    <FrameLayout
        android:id="@+id/centerMarkerLayout"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center">

        <View
            android:id="@+id/markerTopLeftHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="top|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopLeftVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="top|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopRightHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="top|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerTopRightVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomLeftHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomLeftVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomRightHorizontal"
            android:layout_width="18dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|end"
            android:background="#DDFFFFFF" />

        <View
            android:id="@+id/markerBottomRightVertical"
            android:layout_width="2dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:background="#DDFFFFFF" />

    </FrameLayout>

    <!-- 우측 하단 최소 거리 HUD -->
    <LinearLayout
        android:id="@+id/distanceHudLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_distance_hud"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvCurrentDistanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="현재 거리"
            android:textColor="#E8E8E8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentDistanceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="1.5 m"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
