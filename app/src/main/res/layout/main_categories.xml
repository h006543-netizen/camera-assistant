<?xml version="1.0" encoding="utf-8"?>
<!-- The overlay root owns visibility and must retain its ID. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCategoryOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:ignore="MergeRootFrame">

    <!-- Pointer-only dismissal; keyboard and accessibility use the title or Back. -->
    <View
        android:id="@+id/categoryScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        tools:ignore="KeyboardInaccessibleWidget"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/mainCategoryMenu"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_popup"
        android:elevation="6dp"
        android:clipToOutline="true"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

        <!-- Consume blank panel taps; only category rows take focus. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"
            tools:ignore="KeyboardInaccessibleWidget"
            android:clickable="true">

            <LinearLayout
                android:id="@+id/tabShootingAssist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_main_tab"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/mainCategoryAssistLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_tab_assist"
                    android:fontFamily="sans-serif"
                    android:textColor="#30343B"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_category_indicator"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabFilmNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_main_tab"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/mainCategoryNotesLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_tab_notes"
                    android:fontFamily="sans-serif"
                    android:textColor="#30343B"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_category_indicator"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
