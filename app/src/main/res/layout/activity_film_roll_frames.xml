<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/note_gallery_background" tools:context=".FilmRollFramesActivity">
    <View android:id="@+id/framesStatusSpace" android:layout_width="match_parent" android:layout_height="0dp" android:background="#151515" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/framesBack" style="@style/NoteIcon" app:tint="@color/note_gallery_text" android:src="@drawable/ic_roll_back" android:contentDescription="@string/note_back_rolls" />
        <TextView android:id="@+id/framesTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:textColor="@color/note_gallery_text" android:textSize="20sp" android:textStyle="bold" tools:text="가을 산책" />
        <ImageButton android:id="@+id/framesFirst" style="@style/NoteIcon" android:padding="8dp" app:tint="@color/note_gallery_text" android:src="@drawable/ic_note_first_frame" android:enabled="false" android:contentDescription="@string/note_first_page" />
        <ImageButton android:id="@+id/framesExport" style="@style/NoteIcon" app:tint="@color/note_gallery_text" android:src="@drawable/ic_note_export" android:contentDescription="@string/note_export_zip" />
        <ImageButton android:id="@+id/framesInfo" style="@style/NoteIcon" app:tint="@color/note_gallery_text" android:src="@drawable/ic_note_info" android:contentDescription="@string/note_roll_info" />
    </LinearLayout>
    <LinearLayout android:id="@+id/framesExportProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/framesExportStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/note_gallery_text" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/framesExportCancel" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/cancel" />
        </LinearLayout>
        <ProgressBar android:id="@+id/framesExportBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginBottom="12dp" android:progressTint="@color/note_gallery_text" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/framesPager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="20dp" android:paddingEnd="0dp" android:clipToPadding="false" android:overScrollMode="never" android:scrollbars="none" tools:itemCount="2" tools:listitem="@layout/item_frame_pair" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:weightSum="100" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="4dp" android:paddingBottom="8dp">
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="15" />
        <com.shutternote.FilmFrameScrubber android:id="@+id/framesScrubber" android:layout_width="0dp" android:layout_weight="70" android:layout_height="48dp" android:minHeight="2dp" android:maxHeight="2dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@null" android:splitTrack="false" android:thumb="@drawable/note_scrub_thumb" android:thumbOffset="12dp" android:progressDrawable="@drawable/note_scrub_track" android:progressTint="@color/note_gallery_rule" android:progressBackgroundTint="@color/note_gallery_rule" android:thumbTint="@color/note_gallery_text" android:tickMark="@null" app:tickMark="@null" android:contentDescription="@string/note_scrub_description" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="15" />
    </LinearLayout>
    <View android:id="@+id/framesNavigationSpace" android:layout_width="match_parent" android:layout_height="0dp" android:background="#000000" />
</LinearLayout>
